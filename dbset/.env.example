# PostgreSQL connection URL for hybrid search tests
# Copy this file to .env and update with your credentials

# Standard PostgreSQL URL format:
DB_URL=postgresql://user:password@localhost:5432/dbname

# Or with psycopg2 driver explicitly:
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/dbname

# For async tests (if needed):
# ASYNC_DB_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
